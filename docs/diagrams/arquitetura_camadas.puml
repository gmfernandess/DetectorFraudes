@startuml
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

package "Camada de apresentacao" as Presentation {
  component "Streamlit Dashboard" as Streamlit
  component "Cliente HTTP" as Client
  component "Scripts CLI" as Scripts
}

package "Camada de API" as ApiLayer {
  component "FastAPI" as FastAPI
  component "Rotas" as Routes
  component "Schemas Pydantic" as Schemas
}

package "Camada de aplicacao" as Application {
  component "PredictionService" as PredictionService
  component "ModelService" as ModelService
  component "DecisionService" as DecisionService
  component "ThresholdService" as ThresholdService
}

package "Camada de dominio ML" as MlDomain {
  component "FraudPredictor" as Predictor
  component "Preprocessing Pipeline" as Preprocessing
  component "Modelos e estrategias" as Models
  component "Treinamento e serializacao" as Training
  component "Metricas e avaliacao" as Evaluation
  component "Analise de threshold" as ThresholdAnalysis
}

package "Camada de dados e infraestrutura" as Infrastructure {
  file "PaySim CSV dataset" as Dataset
  artifact "fraud_model_artifact.joblib" as Artifact
  folder "Resultados" as Results
  component "Configuracao e logging" as Config
}

Streamlit --> Predictor : inferencia local
Client --> FastAPI : HTTP
Scripts --> Predictor : predicao local
Scripts --> Training : treino
Scripts --> ThresholdAnalysis : reavaliacao
Scripts --> Artifact : inspecao do artefato

FastAPI --> Routes
Routes --> Schemas
Routes --> PredictionService
Routes --> ThresholdService
Routes --> ModelService : metadata e artefato

PredictionService --> Predictor
ModelService --> Artifact
Predictor --> ModelService
Predictor --> Artifact : usa pipeline e estimador
Predictor --> DecisionService : classifica risco
ThresholdService --> ThresholdAnalysis
ThresholdService --> Artifact : usa holdout
ThresholdAnalysis --> Evaluation

Training --> Dataset : carrega e divide
Training --> Preprocessing : ajusta no treino
Training --> Models : compara candidatos
Training --> Evaluation : calcula metricas
Training --> ThresholdAnalysis : seleciona threshold
Training --> Artifact : gera artefato
Training --> Results : persiste metricas
ThresholdAnalysis --> Artifact : le holdout salvo
Config ..> FastAPI
Config ..> Application

note right of Artifact
Artefato reutilizado pela API
sem retreinamento por requisicao.
end note

note bottom of ThresholdAnalysis
A analise de threshold ocorre no fluxo de treinamento
ou reavaliacao sobre o holdout salvo.
end note
@enduml
