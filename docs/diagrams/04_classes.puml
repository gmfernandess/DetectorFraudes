@startuml
skinparam classAttributeIconSize 0
class PredictionService {
  +predict(features): PredictResponse
}
class ModelService {
  +get_predictor(): FraudPredictor
  +reload_predictor(): FraudPredictor
}
class DecisionService {
  +decide(probability): DecisionResult
}
class ThresholdService {
  +reevaluate(probabilities, y_true, step, minimum_precision, minimum_recall): ThresholdArtifacts
  +table(): DataFrame
}
class FraudPredictor {
  +predict_transaction(payload): dict
  +explain(features, transformed): list
}
class ModelArtifact {
  model_name
  model_version
  threshold
  threshold_low
  threshold_high
  threshold_strategy
  threshold_strategy_parameters
  metrics
  threshold_table
  best_thresholds
  holdout_probabilities
  holdout_truth
  feature_columns
  preprocessor
  estimator
}
class PredictRequest {
  features
}
class PredictResponse {
  fraud_probability
  threshold
  prediction
  risk
  decision
  model_name
  model_version
  top_contributors
}
class DecisionResult {
  risk
  decision
}
abstract class ThresholdStrategy {
  +select(table): row
}
class MaxF1Strategy
class MaxF2Strategy
class MaxRecallWithMinPrecisionStrategy
class MaxPrecisionWithMinRecallStrategy
class CostThresholdStrategy {
  cost_fn
  cost_fp
  amount_weighted
  +add_cost_columns(table, y_true, probabilities, amount): DataFrame
}

PredictionService --> FraudPredictor : utiliza
PredictionService ..> PredictRequest : recebe
PredictionService ..> PredictResponse : retorna
FraudPredictor --> ModelService : obtém artefato
FraudPredictor --> DecisionService : solicita decisão
FraudPredictor --> ModelArtifact : usa metadata e thresholds
DecisionService --> DecisionResult : retorna
ModelService --> ModelArtifact : carrega
ThresholdService --> ModelArtifact : reavalia holdout
ThresholdStrategy <|-- MaxF1Strategy
ThresholdStrategy <|-- MaxF2Strategy
ThresholdStrategy <|-- MaxRecallWithMinPrecisionStrategy
ThresholdStrategy <|-- MaxPrecisionWithMinRecallStrategy
ThresholdStrategy <|-- CostThresholdStrategy
@enduml
