@startuml
left to right direction
node "Ambiente de execução" {
  node "Container / Processo Frontend" as FE {
    component "Streamlit Dashboard" as Streamlit
  }
  node "Container / Processo API" as API {
    component "FastAPI" as FastAPI
    component "FraudPredictor" as ML
  }
  artifact "fraud_model_artifact.joblib" as Artifact
}
node "Cliente" as Client
node "Ambiente de treinamento e análise" as Train {
  artifact "Dataset" as Dataset
  component "scripts/train.py" as Trainer
  component "scripts/threshold_analysis.py" as Threshold
  artifact "Resultados / Threshold Tables" as Results
}
Client --> Streamlit : HTTP
Client --> FastAPI : HTTP
Streamlit --> FastAPI : REST
FastAPI --> ML
ML --> Artifact : carrega artefato
Trainer --> Dataset
Trainer --> Artifact : gera artefato
Threshold --> Artifact : reavalia thresholds
Threshold --> Results : persiste métricas
@enduml
